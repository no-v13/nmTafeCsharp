<Window x:Class="recruiteAssessment.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:recruiteAssessment"
        mc:Ignorable="d"
        Title="Recruitment Agency Management system" FontSize="100" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Margin="5" >
            <TextBlock Text="Contractor Management" FontSize="20" FontWeight="Bold" Margin="5"/>

            <Grid> 
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
           
                <Label Content="First Name:" FontSize="15"  Grid.Row="0" Grid.Column="0"/>
                <TextBox x:Name="txtFirstName" FontSize="15" Grid.Row="0" Grid.Column="1"/>

                <Label Content="Last Name:"  FontSize="15" Grid.Row="1" Grid.Column="0"/>
                <TextBox  x:Name="txtLastName" FontSize="15" Grid.Row="1" Grid.Column="1"/>


                <Label Content="Start Date"  FontSize="15" Grid.Row="2" Grid.Column="0"/>
                <DatePicker Name="txtStartdate" FontSize="15" Grid.Row="2" Grid.Column="1"/>


                <Button x:Name="addContractor" Content="Add Contractor" Click="addButton_Click" FontSize="15"  Grid.Row="3" Grid.Column="0" Margin="5"/>
                <Button x:Name="delContractor" Content="Delete Contractor" Click="delButton_Click" FontSize="15" Grid.Row="3" Grid.Column="1" Margin="5"/>

                <Button x:Name="SearchEmployee" Content="Search" FontSize="15" Grid.Row="4" Grid.Column="0" Click="SearchEmployee_Click" Margin="5"/>
                <TextBox Name="txtContSearch" FontSize="15" Grid.Row="4" Grid.Column="1"/>

            </Grid>
        </StackPanel>

        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="5*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Employee List"
               FontSize="20"
               FontWeight="Bold"
               Grid.Row="0" VerticalAlignment="Center" Margin="5,0,0,0"/>
            
            
            <ListView x:Name="txtEmployeeList"
              Grid.Row="1"
              BorderBrush="Black"
              BorderThickness="1" FontSize="15" Margin="0,5,5,0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="FirstName" DisplayMemberBinding="{Binding Path= FirstName}"/>
                        <GridViewColumn Header="LastName" DisplayMemberBinding="{Binding  Path= LastName}" />
                        <GridViewColumn Header="Startdate" DisplayMemberBinding="{Binding Path= Startdate}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        
        
        <StackPanel Grid.Row="0" Grid.Column="1" >
            <TextBlock Text="Job management(Job-emplyee match)" FontSize="20" FontWeight="Bold" Margin="10"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    
                </Grid.RowDefinitions>

                <Label Content="Job Title:"  FontSize="15" Grid.Row="0" Grid.Column="0"/>
                <TextBox x:Name="txtJobTitle" FontSize="15" Grid.Row="0" Grid.Column="1"/>

                <Label Content="Job Date:"  FontSize="15" Grid.Row="1" Grid.Column="0"/>
                <DatePicker x:Name="txtJobDate" FontSize="15" Grid.Row="1" Grid.Column="1"/>
                

                <Label Content="Total Salary:" FontSize="15" Grid.Row="2" Grid.Column="0"/>
                <TextBox x:Name="txtJobSalary" FontSize="15" Grid.Row="2" Grid.Column="1"/>

                <Label Content="Contractor List"  FontSize="15" Grid.Row="3" Grid.Column="0"/>
                <ComboBox x:Name="cmbAssignWorker" FontSize="15" Grid.Row="3" Grid.Column="1" SelectionChanged="cmbAssignWorker_SelectionChanged"/>

                <Button x:Name="addJob" Content="Add Job" Click="addJob_Click" FontSize="15" Grid.Row="4" Grid.Column="0" Margin="5"/>
                <Button x:Name="delJob" Content="Delete Job" Click="delJob_Click" FontSize="15" Grid.Row="4" Grid.Column="1" Margin="5"/>

            </Grid>
        </StackPanel>





        <Grid Grid.Row="1" Grid.Column="1" >
            <Grid Grid.Row="1" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="5*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Job List" FontSize="20" FontWeight="Bold"
                           Grid.Row="0" VerticalAlignment="Center" Margin="5,0,0,5"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal">

                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Cost Range:" Grid.Column="0" FontSize="13" VerticalAlignment="Center" Margin="0,0,2,0"/>
                        <TextBox x:Name="txtMincost" Width="55" Height="24" FontSize="14" VerticalContentAlignment="Center" Grid.Column="1"/>
                        <TextBlock Text=" - " FontSize="15" VerticalAlignment="Center" Grid.Column="2"/>
                        <TextBox x:Name="txtMaxcost" Width="55" Height="24" FontSize="14" VerticalContentAlignment="Center" Grid.Column="3"/>
                        <Button Content="Search" x:Name="jobCostSearch" FontSize="14" Margin="2" Click="jobCostSearch_Click" Grid.Column="4"/>
                        <Button Content="Reset" x:Name="jobCostReset" FontSize="14" Margin="2" Click="jobCostReset_Click" Grid.Column="5"/>
                    </Grid>
                    
                    
                </StackPanel>
                
                
                <ListView x:Name="txtJobList" Grid.Row="2" BorderBrush="Black"
                          BorderThickness="1" FontSize="15" Margin="0,5,5,0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="jobTitle" DisplayMemberBinding="{Binding Path= jobTitle}"/>
                            <GridViewColumn Header="totalSalary" DisplayMemberBinding="{Binding Path=totalSalary}"/>
                            <GridViewColumn Header="jobDate" DisplayMemberBinding="{Binding Path= jobDate}"/>
                            <GridViewColumn Header="Assigned worker"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>


        </Grid>
        
    </Grid>
</Window>
